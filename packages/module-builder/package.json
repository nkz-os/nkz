{
    "name": "@nekazari/module-builder",
    "version": "2.1.0",
    "private": false,
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nkz-os/nkz.git"
    },
    "description": "Vite preset for building Nekazari modules as Module Federation 2.0 remotes",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@module-federation/vite": "^1.15.4",
        "esbuild": "^0.25.1"
    },
    "peerDependencies": {
        "vite": ">=5.0.0",
        "@vitejs/plugin-react": "^4.0.0",
        "@nekazari/module-kit": ">=0.6.0"
    },
    "scripts": {
        "build": "tsc",
        "prepublishOnly": "pnpm run build",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "vite": "^6.4.2",
        "typescript": "^5.5.0",
        "vitest": "^3.2.6",
        "ts-morph": "^23.0.0",
        "@nekazari/module-kit": "workspace:*"
    }
}

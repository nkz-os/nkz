{
    "name": "@nekazari/module-builder",
    "version": "1.2.0",
    "private": false,
    "license": "Apache-2.0",
    "description": "Vite preset for building Nekazari module IIFE bundles",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "vite-node": "^2.1.8"
    },
    "peerDependencies": {
        "vite": ">=5.0.0",
        "@vitejs/plugin-react": ">=4.0.0",
        "@nekazari/module-kit": ">=0.2.0"
    },
    "scripts": {
        "build": "tsc",
        "prepublishOnly": "pnpm run build",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "vite": "^5.4.0",
        "typescript": "^5.5.0",
        "vitest": "^2.1.8",
        "ts-morph": "^23.0.0",
        "@nekazari/module-kit": "workspace:*"
    }
}
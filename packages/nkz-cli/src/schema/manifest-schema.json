{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "name", "display_name", "version", "description", "build_config"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string", "minLength": 1 },
    "api_contract": {
      "type": "object",
      "required": ["hostApiVersion", "moduleApiVersion", "sdkVersion"],
      "properties": {
        "hostApiVersion": { "type": "string" },
        "moduleApiVersion": { "type": "string" },
        "sdkVersion": { "type": "string" }
      }
    },
    "build_config": {
      "type": "object",
      "required": ["type", "remote_entry_url"],
      "properties": {
        "type": { "type": "string", "const": "iife" },
        "remote_entry_url": { "type": "string", "minLength": 1 }
      }
    }
  }
}

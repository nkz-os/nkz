{
  "name": "@nekazari/design-tokens",
  "version": "0.1.0-alpha.3",
  "private": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkz-os/nkz.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./css": "./dist/tokens.css",
    "./tailwind": "./dist/tailwind-preset.js",
    "./native": "./dist/native-tokens.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsx src/build-css.ts && tsx src/build-tailwind.ts && tsx src/build-native.ts && tsup src/index.ts --format cjs,esm --dts --external react,react-dom",
    "dev": "tsx watch src/build-css.ts",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "tsup": "^8.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.2.2",
    "vitest": "^5.0.1"
  }
}

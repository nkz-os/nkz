{
  "framework": "vite",
  "buildCommand": "pnpm --filter @nekazari/sdk run build && pnpm --filter @nekazari/ui-kit run build && pnpm --filter nekazari-frontend run build",
  "outputDirectory": "apps/host/dist",
  "installCommand": "pnpm install --no-frozen-lockfile --shamefully-hoist",
  "rewrites": [
    {
      "source": "/ngsi-ld/(.*)",
      "destination": "https://nkz.YOUR_DOMAIN/ngsi-ld/$1"
    },
    {
      "source": "/api/admin/(.*)",
      "destination": "https://nkz.YOUR_DOMAIN/api/admin/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://nkz.YOUR_DOMAIN/api/$1"
    },
    {
      "source": "/sdm/(.*)",
      "destination": "https://nkz.YOUR_DOMAIN/sdm/$1"
    },
    {
      "source": "/grafana/(.*)",
      "destination": "https://nkz.YOUR_DOMAIN/grafana/$1"
    },
    {
      "source": "/n8n/(.*)",
      "destination": "https://nkz.YOUR_DOMAIN/n8n/$1"
    },
    {
      "source": "/entity-manager/(.*)",
      "destination": "https://nkz.YOUR_DOMAIN/entity-manager/$1"
    },
    {
      "source": "/ros2-bridge/(.*)",
      "destination": "https://nkz.YOUR_DOMAIN/ros2-bridge/$1"
    },
    {
      "source": "/ros2-fiware-bridge-service/(.*)",
      "destination": "https://nkz.YOUR_DOMAIN/ros2-fiware-bridge-service/$1"
    },
    {
      "source": "/webhook/(.*)",
      "destination": "https://nkz.YOUR_DOMAIN/webhook/$1"
    },
    {
      "source": "/forgot-password",
      "destination": "https://nkz.YOUR_DOMAIN/forgot-password"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://auth.YOUR_DOMAIN/auth/$1"
    },
    {
      "source": "/auth",
      "destination": "https://auth.YOUR_DOMAIN/auth"
    },
    {
      "source": "/realms/(.*)",
      "destination": "https://auth.YOUR_DOMAIN/realms/$1"
    },
    {
      "source": "/realms",
      "destination": "https://auth.YOUR_DOMAIN/realms"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}



    {
      "_comment": "Nekazari Platform NGSI-LD @context — canonical namespace mappings. Types prefixed 'nkz:' are platform extensions (no SDM/SAREF4AGRI equivalent per FIWARE Smart Data Models catalog audit 2026-05-03). Types prefixed 'saref4agri:' are legacy — retained for backward compatibility with existing Orion-LD entities; new entities SHOULD use 'nkz:' variants.",
      "schema": "https://schema.org/",
      "ngsi-ld": "https://uri.etsi.org/ngsi-ld/",
      "iot": "https://iot.schema.org/",
      "saref": "https://saref.etsi.org/core/",
      "saref4agri": "https://saref.etsi.org/saref4agri/",
      "nkz": "https://nekazari.robotika.cloud/ngsi-ld/",
      "AgriculturalRobot": {
        "@id": "nkz:AgriculturalRobot",
        "@type": "@id",
        "_comment": "Platform extension — no equivalent in SAREF4AGRI or any SDM catalog. Alias: AgriRobot (robotics module) maps to same nkz:AgriculturalRobot URI. Legacy mapping: saref4agri:AgriculturalRobot."
      },
      "AgriSensor": {
        "@id": "nkz:AgriSensor",
        "@type": "@id",
        "_comment": "Platform extension — SAREF4AGRI has no AgriSensor class (only specific sensor types like Pluviometer, Thermometer). Legacy mapping: saref4agri:AgriSensor."
      },
      "AgriParcel": {
        "@id": "https://saref.etsi.org/saref4agri/AgriParcel",
        "@type": "@id",
        "_comment": "SAREF4AGRI AgriParcel — canonical type used by GIS-Routing for parcel creation. Legacy mapping: nkz:AgriParcel."
      },
      "AgriOperation": {
        "@id": "nkz:AgriOperation",
        "@type": "@id",
        "_comment": "Platform extension — no SAREF4AGRI equivalent. Legacy mapping: saref4agri:AgriOperation."
      },
      "AgriculturalTractor": {
        "@id": "nkz:AgriculturalTractor",
        "@type": "@id",
        "_comment": "Platform extension — no SDM type exists for agricultural tractors. Closest: ManufacturingMachine. Legacy mapping: saref4agri:AgriculturalTractor."
      },
      "AgriculturalImplement": {
        "@id": "nkz:AgriculturalImplement",
        "@type": "@id",
        "_comment": "Platform extension — no SDM type exists for agricultural implements. Legacy mapping: saref4agri:AgriculturalImplement."
      },
      "AgriEquipment": {
        "@id": "nkz:AgriEquipment",
        "@type": "@id",
        "_comment": "Platform extension — no SDM type exists for generic agricultural equipment. Used as parent type for tractors and implements."
      },
      "AgriParcelOperation": {
        "@id": "nkz:AgriParcelOperation",
        "@type": "@id",
        "_comment": "Platform extension — SDM AgriParcelOperation lacks agricultural machinery kinematics properties. Platform extends with A-B lines and VRA fields."
      },
      "AgriCropObservation": {
        "@id": "nkz:AgriCropObservation",
        "@type": "@id",
